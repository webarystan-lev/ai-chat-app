        transform: translateY(-1px);
    }
    
    /* Специфическое оформление для сообщений пользователя и ассистента */
    [data-testid="stChatMessageUser"] {
        background-color: #1e1b4b !important; /* глубокий фиолетово-синий */
        border-left: 4px solid #818cf8 !important;
