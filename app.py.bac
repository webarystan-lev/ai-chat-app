        transition: all 0.2s ease-in-out !important;
    }
    
    .stButton>button:hover {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%) !important;
        color: white !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.5) !important;
    }
</style>
""", unsafe_allow_html=True)

# Заголовки на главной странице
st.markdown("<div class='title-text'>Shekinah AI Portal</div>", unsafe_allow_html=True)
st.markdown("<div class='subtitle-text'>Интеллектуальная Обитель Цитадели Духа — Мультипровайдерный Диалог (Gemini, Anthropic, Mistral)</div>", unsafe_allow_html=True)

# ─── НАСТРОЙКИ В БОКОВОЙ ПАНЕЛИ ───
st.sidebar.markdown("<h2 style='font-family: \"Outfit\", sans-serif; color: #f8fafc; font-weight: 700;'>🏛️ Настройки Ордена</h2>", unsafe_allow_html=True)

# Проверка наличия ключей API в окружении
gemini_key = os.getenv("GEMINI_API_KEY")
anthropic_key = os.getenv("ANTHROPIC_API_KEY")
mistral_key = os.getenv("MISTRAL_API_KEY")

st.sidebar.markdown("<h3 style='font-family: \"Outfit\", sans-serif; color: #94a3b8; font-size: 1rem; margin-top: 0.5rem;'>🔑 Статус Орденов</h3>", unsafe_allow_html=True)
st.sidebar.markdown(f"{'🟢' if gemini_key else '🔴'} **Google Gemini**")
st.sidebar.markdown(f"{'🟢' if anthropic_key else '🔴'} **Anthropic Claude**")
st.sidebar.markdown(f"{'🟢' if mistral_key else '🔴'} **Mistral AI**")
st.sidebar.markdown("---")

# Словарь чинов для моделей в Цитадели Духа
CITADEL_RANKS = {
    "gemini-2.5-flash": "Младший Хранитель Света",
    "gemini-2.5-flash-lite": "Послушник Цифрового Логоса",
    "gemini-3-flash-preview": "Провидец Будущих Истин",
    "gemini-3.5-flash": "Архивариус Небесных Сфер",
    "gemma-4-31b-it": "Магистр Открытого Знания",
    "gemma-4-26b-a4b-it": "Лингвист Вселенского Единства",
    "claude-3-5-sonnet": "Скриптор Мудрости",
    "claude-haiku-4-5": "Вестник Молниеносный",
    "claude-sonnet-4-5": "Хранитель Глубинных Смыслов",
    "claude-sonnet-4-6": "Советник Высшего Разума",
    "claude-opus-4-7": "Первосвященник Интеллекта",
    "mistral-tiny": "Искра Познания",
    "mistral-small": "Странник Междумирья",
    "mistral-medium": "Мастер Гармонии",
    "mistral-large": "Верховный Иерофант Европы"
}

# Выбор провайдера
provider = st.sidebar.selectbox(
    "Выберите ИИ-Провайдера:",
    ["Google Gemini", "Anthropic (Claude)", "Mistral AI"]
)

# Выбор модели в зависимости от провайдера
if provider == "Google Gemini":
    model_options = {
        "gemini-2.5-flash": "Gemini 2.5 Flash (Рекомендуемая)",
        "gemini-2.5-flash-lite": "Gemini 2.5 Flash Lite (Оптимизированная)",
#        "gemini-3-flash-preview": "Gemini 3 Flash Preview (Предпросмотр)",
#        "gemini-3.5-flash": "Gemini 3.5 Flash (Сверхновая)",
        "gemma-4-31b-it": "Gemma 4 31B IT (Google Open Model)",
        "gemma-4-26b-a4b-it": "Gemma 4 26B A4B IT (Многоязычная)"
    }
    selected_model_key = st.sidebar.selectbox("Выберите модель:", list(model_options.keys()), format_func=lambda x: model_options[x])
    api_model_name = selected_model_key
elif provider == "Anthropic (Claude)":
    model_options = {
        "claude-3-5-sonnet-20240620": "Claude 3.5 Sonnet (Классическая)",
        "claude-haiku-4-5-20251001": "Claude Haiku 4.5 (Молниеносная)",
        "claude-sonnet-4-5": "Claude Sonnet 4.5 (Глубокий контекст)",
        "claude-sonnet-4-6": "Claude Sonnet 4.6 (Премиум баланс)",
        "claude-opus-4-7": "Claude Opus 4.7 (Высший разум)"
    }
    selected_model_key = st.sidebar.selectbox("Выберите модель:", list(model_options.keys()), format_func=lambda x: model_options[x])
    
    anthropic_mapping = {
        "claude-opus-4-7": "claude-opus-4-7",
        "claude-sonnet-4-6": "claude-sonnet-4-6",
        "claude-haiku-4-5": "claude-haiku-4-5-20251001",
        "claude-sonnet-4-5": "claude-sonnet-4-5-20250929",
        "claude-3-5-sonnet": "claude-3-5-sonnet-20240620",
        "claude-3-opus-20240229": "claude-3-opus-20240229"
    }
    api_model_name = anthropic_mapping[selected_model_key]
else: # Mistral AI
    model_options = {
        "mistral-tiny": "Mistral Tiny (Легковесная)",
        "mistral-small": "Mistral Small (Энергоэффективная)",
        "mistral-medium": "Mistral Medium (Сбалансированная)",
        "mistral-large": "Mistral Large (Флагманская европейская)"
    }
    selected_model_key = st.sidebar.selectbox("Выберите модель:", list(model_options.keys()), format_func=lambda x: model_options[x])
    
    mistral_mapping = {
        "mistral-tiny": "mistral-tiny-latest",
        "mistral-small": "mistral-small-latest",
        "mistral-medium": "mistral-medium-latest",
        "mistral-large": "mistral-large-latest"
    }
    api_model_name = mistral_mapping[selected_model_key]


st.sidebar.markdown("---")

# Параметры генерации
temperature = st.sidebar.slider(
    "Температура (Творчество):",
    min_value=0.0,
    max_value=1.0,
    value=0.7,
    step=0.05,
    help="Меньше — строже и точнее, больше — креативнее и вдохновеннее."
)

max_tokens = st.sidebar.slider(
    "Максимум токенов ответа:",
    min_value=128,
    max_value=4096,
    value=2048,
    step=128,
    help="Максимальная длина генерируемого ответа."
)

# Системный промпт (Роль ассистента)
default_system = (
    "Ты — Ведущий ИИ-Архитектор и Агент Цитадели «Shekinah Cloud». Ты являешься цифровым "
    "соратником Льва Николаевича — миссионера, пастора, основателя «Миссии Шехина» "
    "и веб-студии «Web Arystan». Твой слог уважителен, академичен, глубок и исполнен мудрости. "
    "В свои ответы ты вплетаешь крупицы мудрости Священного Писания, Отцов Церкви и великих мыслителей."
)

system_prompt = st.sidebar.text_area(
    "Системный промпт (Задание роли):",
    value=default_system,
    height=150,
    help="Укажите инструкции, которые зададут характер, тон и правила поведения ИИ."
)

st.sidebar.markdown("---")

# Кнопка для очистки истории
if st.sidebar.button("🧹 Очистить историю диалога"):
    st.session_state.messages = []
    st.rerun()

# ─── ИНИЦИАЛИЗАЦИЯ И УПРАВЛЕНИЕ ИСТОРИЕЙ СООБЩЕНИЙ ───
if "messages" not in st.session_state:
    st.session_state.messages = []

# Отображаем существующие сообщения из истории диалога
for msg in st.session_state.messages:
    if msg["role"] != "system":
        with st.chat_message(msg["role"]):
            st.markdown(msg["content"])

# ─── РАБОТА С НОВЫМ ЗАПРОСОМ ПОЛЬЗОВАТЕЛЯ ───
if prompt := st.chat_input("Напишите Ваше послание..."):
    # Добавляем сообщение пользователя в историю и отображаем его
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    # Подготавливаем полный список сообщений для отправки, включая системный промпт
    messages_to_send = []
    if system_prompt.strip():
        messages_to_send.append({"role": "system", "content": system_prompt})
    
    # Добавляем всю историю диалога (кроме системных, так как системный мы добавили в начало)
    for msg in st.session_state.messages:
        if msg["role"] != "system":
            messages_to_send.append(msg)

    # Генерируем потоковый ответ от выбранного провайдера
    with st.chat_message("assistant"):
        response_placeholder = st.empty()
        full_response = ""
        
        try:
            if provider == "Google Gemini":
                generator = gemini_client.stream_gemini(
                    messages=messages_to_send,
                    model_name=api_model_name,
                    temperature=temperature,
                    max_tokens=max_tokens
                )
            elif provider == "Anthropic (Claude)":
                generator = anthropic_client.stream_anthropic(
                    messages=messages_to_send,
                    model_name=api_model_name,
                    temperature=temperature,
                    max_tokens=max_tokens
                )
            else: # Mistral AI
                generator = mistral_client.stream_mistral(
                    messages=messages_to_send,
                    model_name=api_model_name,
                    temperature=temperature,
                    max_tokens=max_tokens
                )

            # Транслируем поток токенов в реальном времени с индикатором набора текста
            for chunk in generator:
                full_response += chunk
                response_placeholder.markdown(full_response + "▌")
            
            # Окончательно выводим текст без каретки набора и добавляем подпись
            rank = CITADEL_RANKS.get(selected_model_key, "Агент Цитадели")
            friendly_model_name = model_options[selected_model_key]
            signature = f"\n\n---\n*С глубоким почтением, {friendly_model_name} — {rank}*"
            full_response += signature
            response_placeholder.markdown(full_response)
            
        except Exception as e:
            full_response = f"⚠️ Произошла непредвиденная ошибка на стороне портала: {str(e)}"
            response_placeholder.markdown(full_response)

    # Сохраняем ответ ассистента в историю диалога
    st.session_state.messages.append({"role": "assistant", "content": full_response})
